<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="aethercore-market-jpa-test" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.aethercore.backend.market.jpa.JpaMarketStock</class>
        <class>com.aethercore.backend.market.jpa.JpaMarketPurchase</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- Schema is managed strictly by Flyway; Hibernate only validates -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.session_factory.statement_inspector"
                      value="com.aethercore.backend.market.jpa.TestStatementInspector"/>
        </properties>
    </persistence-unit>

    <persistence-unit name="aethercore-fetch-jpa-test" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.aethercore.backend.fetch.FetchBuyer</class>
        <class>com.aethercore.backend.fetch.FetchOrder</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.session_factory.statement_inspector"
                      value="com.aethercore.backend.fetch.FetchStatementInspector"/>
            <property name="hibernate.generate_statistics" value="true"/>
            <property name="hibernate.cache.use_second_level_cache" value="false"/>
            <property name="hibernate.cache.use_query_cache" value="false"/>
            <property name="hibernate.default_batch_fetch_size" value="1"/>
        </properties>
    </persistence-unit>

    <persistence-unit name="aethercore-pagination-jpa-test" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.aethercore.backend.fetch.FetchBuyer</class>
        <class>com.aethercore.backend.fetch.FetchOrder</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.generate_statistics" value="true"/>
            <property name="hibernate.cache.use_second_level_cache" value="false"/>
            <property name="hibernate.cache.use_query_cache" value="false"/>
            <property name="hibernate.default_batch_fetch_size" value="0"/>
        </properties>
    </persistence-unit>
</persistence>
